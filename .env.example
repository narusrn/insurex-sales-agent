# --- LLM provider ---
LLM_PROVIDER=openai          # openai | azure
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-large

# --- RAG subgraph ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=2
RETRIEVER_MAX_REWRITES=2

# --- Top-level loop guard ---
GRAPH_MAX_STEPS=3

# --- Context trim + summarize ([§5]) ---
CONTEXT_TOKEN_THRESHOLD=2000
CONTEXT_KEEP_TOKENS=800
